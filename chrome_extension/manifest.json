{
  "manifest_version": 3,
  "name": "AI Code Masker & Utils",
  "version": "1.0",
  "description": "Privacy-first code masking and daily developer utilities.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
